table bank_churn_clean
	lineageTag: 80267cca-9eb7-4831-a443-a94757455a76

	column customer_id
		dataType: int64
		formatString: 0
		lineageTag: b0f4ca70-ba08-4e38-8654-c8069d3aaf05
		summarizeBy: sum
		sourceColumn: customer_id

		annotation SummarizationSetBy = Automatic

